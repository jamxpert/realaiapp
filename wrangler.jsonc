{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The site on realaiapps.com. `npm run build` writes every page into out/,
  // and this Worker serves those files. There is no server code.
  "name": "realaiapps",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "realaiapps.com", "custom_domain": true },
    { "pattern": "www.realaiapps.com", "custom_domain": true }
  ]
}
