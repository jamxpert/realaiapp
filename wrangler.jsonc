{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "realaiapp",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "realaiapps.com", "custom_domain": true },
    { "pattern": "www.realaiapps.com", "custom_domain": true }
  ]
}
